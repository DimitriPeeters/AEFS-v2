Options -Indexes
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Applicatiecode, configuratie, wachtrijen en dependencies zijn nooit
    # rechtstreeks via HTTP bereikbaar.
    RewriteRule ^(?:app|bin|bootstrap|config|routes|src|storage|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:composer\.(?:json|lock)|DEPLOYMENT\.md)$ - [F,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "(^\.|\.example\.php$|composer\.(json|lock)$)">
    Require all denied
</FilesMatch>
